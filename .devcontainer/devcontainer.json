{
  // Run Accent Coach in GitHub Codespaces: Code > Codespaces > Create codespace.
  // The app starts by itself and opens in a new browser tab on port 8765.
  "name": "Accent Coach",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends ffmpeg && python -m pip install --user uv && python -m uv sync",
  "postAttachCommand": "python -m uv run accent-analyzer app --no-browser",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": { "label": "Accent Coach", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
